---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  page: string;
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noscriptCss?: string;
}
const {
  page, title, description, canonical, ogType = 'website', ogTitle = title,
  ogDescription = description, ogImage, twitterTitle = ogTitle,
  twitterDescription = ogDescription, twitterImage = ogImage, noindex = false,
  schema, noscriptCss = '.reveal{opacity:1 !important;transform:none !important}',
} = Astro.props;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="/" />
  <script is:inline>(function(){try{if(localStorage.getItem("emerging-clarity-theme")==="light")document.documentElement.setAttribute("data-theme","light")}catch(e){}})();</script>
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#07090a" />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg?v=2" />
  {ogTitle && <meta property="og:type" content={ogType} />}
  {ogTitle && <meta property="og:site_name" content="Emerging Clarity" />}
  {ogTitle && <meta property="og:title" content={ogTitle} />}
  {ogDescription && <meta property="og:description" content={ogDescription} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}
  {canonical && <meta property="og:url" content={canonical} />}
  {twitterTitle && <meta name="twitter:card" content="summary_large_image" />}
  {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
  {twitterDescription && <meta name="twitter:description" content={twitterDescription} />}
  {twitterImage && <meta name="twitter:image" content={twitterImage} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/site.css?v=11" />
  <noscript><style is:inline set:html={noscriptCss}></style></noscript>
  {schemas.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
</head>
<body data-page={page}>
  <Header page={page} />
  <slot />
  <Footer />
  <script is:inline src="/site.js?v=13"></script>
</body>
</html>
